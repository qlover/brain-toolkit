{
  "name": "@pamenv/next",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Load PAM env into process.env before Next.js reads its config",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "package.json", "README.md"],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "pamenv-cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  }
}
