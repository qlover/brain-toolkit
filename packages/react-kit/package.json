{
  "name": "@brain-toolkit/react-kit",
  "version": "0.6.0",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "type-check": "tsc --build",
    "dev:example": "vite --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts",
    "preview:example": "vite preview --config vite.example.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlover/brain-toolkit.git",
    "directory": "packages/react-kit"
  },
  "homepage": "https://github.com/qlover/brain-toolkit/tree/master/packages/react-kit#readme",
  "keywords": [
    "brain toolkit",
    "react-kit",
    "hooks"
  ],
  "author": "qlover",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "import": "./dist/hooks/index.js",
        "require": "./dist/hooks/index.cjs"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "import": "./dist/hooks/*.js",
        "require": "./dist/hooks/*.cjs"
      }
    }
  },
  "devDependencies": {
    "@qlover/corekit-bridge": "^3.4.0",
    "@qlover/fe-corekit": "^3.4.0",
    "@qlover/slice-store-react": "^1.4.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "react": "^18.3.1",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@qlover/corekit-bridge": "^3.4.0",
    "@qlover/fe-corekit": "^3.4.0",
    "@qlover/slice-store-react": "^1.4.2"
  }
}
