    "@supabase/supabase-js": "^2.57.2",
    "@types/react": "^19",
    "clsx": "^2.1.1",
    "inversify": "^7.8.1",
    "jsdom": "^28.0.0",
    "next": "^16.1.6",
    "react": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "vitest": "^3.2.4",
