{
  "name": "@brain-toolkit/issue-forge",
  "version": "0.1.1",
  "type": "module",
  "private": false,
  "description": "Forge-agnostic Issue gateway + optional feedback→Issue sync engines; GitHub App first",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js",
      "require": "./dist/feedback/index.cjs",
      "default": "./dist/feedback/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --build",
    "test": "vitest run --config vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlover/brain-toolkit.git",
    "directory": "packages/issue-forge"
  },
  "homepage": "https://github.com/qlover/brain-toolkit#readme",
  "author": "qlover",
  "license": "ISC",
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "tsup": "^8.4.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "github-app",
    "issue",
    "forge",
    "webhook",
    "feedback"
  ],
  "publishConfig": {
    "access": "public"
  }
}
