{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "./ts-build",
    "allowJs": false,
    "esModuleInterop": true,
    "tsBuildInfoFile": "./ts-build/.tsbuildinfo",
    "types": ["node", "vitest/globals"],
    "lib": ["ESNext"]
  },
  "include": ["src", "package.json"],
  "exclude": [
    "dist",
    "node_modules",
    "ts-build",
    "__tests__",
    "__mocks__",
    "example"
  ],
  "references": []
}
