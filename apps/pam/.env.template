# 复制本文件为 `.env` 后按需填写。勿将含真实密钥的 `.env` 提交到版本库。
# 另：`ServerConfig` 还支持 `APP_ENV`、`LK_NODE_SEMANTIC_MAX_COSINE_DISTANCE`、`LK_NODE_SEMANTIC_DEDUP_ENABLED` 等，见 `server/ServerConfig.ts`。
#
# ===== 服务端（Server）=====

# 站点对外访问的根 URL，用于生成绝对链接、回调地址等（与 next-sitemap 可共用逻辑）。
# 使用：填生产或本地可访问的完整地址，末尾一般不加斜杠。
# 示例: https://example.com
# 示例: http://localhost:3000
SITE_URL=

# Supabase 项目 URL（服务端用，与 Dashboard → Project Settings → API 中的 Project URL 一致）。
# 使用：创建 Supabase 项目后复制 URL；前端若使用 `NEXT_PUBLIC_SUPABASE_URL` 需与之对应。
# 示例: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase「匿名 / 公开」密钥（anon public key），服务端通过 `SUPABASE_ANON_KEY` 读取。
# 使用：从同一 API 设置页复制 anon key；勿把 service_role 密钥写进可被前端打包的变量。
# 示例: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=

# 签发与校验登录 JWT 的密钥，须足够随机且保密。
# 使用：本地可用 `openssl rand -hex 32` 生成；生产务必使用独立强随机字符串。
# 示例: a1b2c3d4e5f678901234567890abcdef0123456789abcdef0123456789abcd
JWT_SECRET=

# OpenAI 兼容接口 API 密钥（Cerebras、OpenAI 官方或自建网关）。
# 使用：在对应平台创建 API Key 后粘贴；未配置时相关 AI 功能不可用。
# 示例: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 示例: csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# OpenAI 兼容接口的根地址（通常含协议与主机；具体 path 由代码拼接）。
# 使用：官方或代理/自建兼容服务的基址，需与所选服务商文档一致。
# 示例: https://api.openai.com/v1
# 示例: https://api.cerebras.ai/v1
OPENAI_BASE_URL=

# 服务端日志级别（会与 `NEXT_PUBLIC_LOG_LEVEL` 一起被读取，客户端优先用带 `NEXT_PUBLIC_` 的变量）。
# 使用：常用 `trace` | `debug` | `info` | `warn` | `error` | `fatal`；生产建议 `info` 或 `warn`。
# 示例: info
LOG_LEVEL=

# 日志前缀模板（占位符会被替换）。
# 使用：可包含 `timestamp`、`level`、`loggerName`、`formattedTimestamp`、`locale` 等；不填则用项目默认模板。
# 示例: '[({loggerName}) {formattedTimestamp} {level}]'
LOG_PREFIX_TEMPLATE=

# Supabase service role key — optional (server only, never expose to client).
# 使用：仅当 OAuth 表启用了 RLS 且 anon 无法写入时需要；无 RLS 时留空，复用 SUPABASE_ANON_KEY 即可。
# 示例: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=

# HttpOnly Next OAuth Wrapper session cookie signing secret (>= 32 random chars).
# 示例: openssl rand -hex 32
SESSION_SECRET=

# PAM CLI Bearer JWT 有效期（`jsonwebtoken` / `ms` 时长字符串）；同时写入 `n_pam_cli_tokens.expires_at`。
# 使用：控制 `pam login` 签发的 CLI Token 多久过期；到期或 `pam logout` 吊销后需重新登录。不填默认 `30d`。
# 示例: 30d
# 示例: 21d
# 示例: 7d
PAM_CLI_TOKEN_EXPIRES_IN=30d

# AES-256-GCM key for encrypting provider refresh tokens in DB (32 bytes, base64).
# 示例: base64:abcd1234...  (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# AES-256-GCM key for sensitive PAM environment variable values at rest (32 bytes, base64).
# 示例: base64:abcd1234...  (generate: openssl rand -base64 32)
# 建议与 ENCRYPTION_KEY 分开；生产勿复用测试默认值。
PAM_ENV_SECRET_KEY=

# Optional comma-separated allowed origins for CORS.
# 示例: https://example.com,https://example.org
API_CORS_ALLOWED_ORIGINS=

# Optional comma-separated allowed methods for CORS.
# 示例: GET,POST,OPTIONS,PUT
API_CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# OAuth session key.
OAUTH_SESSION_KEY=

# ===== Brain OAuth 登录（PAM 作为客户端，授权码 + PKCE）=====
# 本地对接 brain-oauth；未配置 SITE_URL / CLIENT_ID 时「Brain PKCE」按钮会失败。

# Brain OAuth 站点根地址（不要末尾斜杠）。
# 示例: http://localhost:3122
BRAIN_OAUTH_SITE_URL=

# 在 Brain OAuth 开发者控制台注册的 client_id。
BRAIN_OAUTH_CLIENT_ID=

# 机密客户端的 client_secret；公共客户端（仅 PKCE）可留空。
BRAIN_OAUTH_CLIENT_SECRET=

# 回调地址，须与 Brain OAuth 控制台 redirect_uri 完全一致。
# 留空则默认 `{SITE_URL}/api/callback/brain-oauth`
# 示例: http://pam.localhost:3400/api/callback/brain-oauth
BRAIN_OAUTH_REDIRECT_URI=

# 授权 scope，空格分隔；默认 openid profile email。
BRAIN_OAUTH_SCOPES=

# 可选：固定授权页 locale（en|zh）；不填则用当前请求 locale。
BRAIN_OAUTH_LOCALE=

# ===== 浏览器 / 公开（NEXT_PUBLIC_* 会打进前端包，勿写服务端密钥）=====

# 可选：站点规范 URL，供 sitemap、robots（next-sitemap）等使用。
# 使用：`next-sitemap.config.js` 优先读此项，否则回退 `SITE_URL` 或 Vercel 环境。
# 示例: https://example.com
NEXT_PUBLIC_SITE_URL=

# 前端简单登录用的用户名（与密码成对；配置会暴露给浏览器，仅适合开发或低敏感内网）。
# 使用：在 `AppConfig` 中读取；生产请改用正式认证。
# 示例: admin
NEXT_PUBLIC_LOGIN_USER=

# 前端简单登录用的密码（会暴露在客户端构建产物中，不适合高安全场景）。
# 示例: your-dev-password
NEXT_PUBLIC_LOGIN_PASSWORD=

# 字符串加解密用的密钥材料；服务端 `ServerConfig.stringEncryptorKey` 与前端共用此变量（会进入前端包）。
# 使用：前后端加密约定需一致时填同一值；勿依赖其保护高敏感数据。
# 示例: 32-chars-minimum-secret-key!!
NEXT_PUBLIC_STRING_ENCRYPT_KEY=

# 浏览器存储用户 Token 时使用的存储键名（如 localStorage）。
# 使用：自定义键名避免与同域其他应用冲突；前后端约定一致即可。
# 示例: xOranj_user_token
NEXT_PUBLIC_USER_TOKEN_KEY=
